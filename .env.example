# Copy to .env (git-ignored). The converter replaces @SWG, @JKA and @CORE3 on its command line with these.
# The folder holding the SWG client's .tre archives:
SWG=C:/SWG
# Jedi Academy's GameData (or GameData/base) folder, for the saber, jump and parry animations:
JKA=C:/Program Files (x86)/Steam/steamapps/common/Jedi Academy/GameData
# Optional: SWGEmu's Core3/MMOCoreORB/bin/scripts, for its spawns and screenplay objects.
#CORE3=C:/Core3/MMOCoreORB/bin/scripts
