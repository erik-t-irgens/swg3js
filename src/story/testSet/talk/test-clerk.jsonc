// The clerk's test conversation: greetings behind conditions (busy while the talk job runs, a second
// greeting once a flag says the two have met), a flag set on reaching a node, a job granted by an answer, the
// talk job's own step done on reaching a node, an answer always shown greyed with its reason, an answer under
// pressure that moves Trust once, a price charged behind its credits condition, an introduction, a gesture
// and a shot written by hand, a line long enough to cut in close, and a goodbye said aloud in other words.
// Once the talk job is done an answer hidden until then (a condition with no "show") pays a tip and moves
// Trust, as often as it is chosen and only once to a character, to a node whose own action is a gesture.
// None of it is story.
{
  "format": 1,
  "id": "test-clerk",
  "rev": 1,
  "source": "test",
  "speaker": "cast/test-clerk",
  "entry": [
    { "when": "questActive(test:talk)", "to": "busy" },
    { "when": "flag(test.clerk.met)", "to": "again" },
    { "to": "hello" },
  ],
  "nodes": {
    "hello": {
      "say": [
        { "text": "TEST: Good day. This is the test clerk's first line.", "tone": "warm" },
        "TEST: And this is the clerk's second line, long enough on purpose that the camera cuts in close on a speaker who goes on for twenty words or more.",
      ],
      "do": ["flag(test.clerk.met, 1)"],
      "replies": [
        { "id": "job", "text": "TEST: Give me the talk job.", "when": "!questActive(test:talk)", "stakes": "TEST: nothing is at stake but a test", "do": ["grant(test:talk)"], "to": "given" },
        { "id": "name", "text": "TEST: Who are you?", "do": ["introduce(cast/test-clerk)"], "to": "named" },
        { "id": "rich", "text": "TEST: A word only the rich may say.", "when": "credits() >= 1000000", "show": "disable", "why": "TEST: you need a million credits", "to": "hello" },
        { "id": "press", "text": "TEST: Answer under pressure.", "pressure": true, "once": true, "stakes": "TEST: the clerk will remember this", "do": ["trust(freelance, 1)"], "to": "pressed" },
        { "id": "pay", "text": "TEST: Pay ten credits for the privilege.", "when": "credits() >= 10", "show": "disable", "why": "TEST: you cannot spare ten credits", "do": ["charge(10)"], "to": "paid" },
        { "id": "tip", "text": "TEST: A tip for the finished job?", "when": "questDone(test:talk)", "pressure": true, "do": ["pay(3)", "trust(freelance, 1)"], "to": "tipped" },
        { "id": "bye", "text": "TEST: Goodbye.", "said": "TEST: Goodbye, then." },
      ],
    },
    "tipped": { "say": ["TEST: Three credits, the once. Ask again and you get the words alone."], "do": ["gesture(emt_bow2)"], "end": true },
    "again": { "say": ["TEST: You again. The flag says we have met."], "next": "hello" },
    "busy": {
      "say": ["TEST: You already have the talk job. Tell me when it is done."],
      "replies": [
        { "id": "done", "text": "TEST: It is done.", "to": "finished" },
        { "id": "bye", "text": "TEST: Goodbye." },
      ],
    },
    "given": { "say": [{ "text": "TEST: The job is yours. Come back and say it is done.", "gesture": "emt_nod_head_once" }], "end": true },
    "named": { "say": [{ "text": "TEST: I am the test clerk. Now you know my name.", "shot": "close-npc" }], "next": "hello" },
    "pressed": { "say": [{ "text": "TEST: Under pressure, then. I will remember that.", "tone": "nervous" }], "end": true },
    "paid": { "say": ["TEST: Ten credits taken. Thank you."], "end": true },
    "finished": { "say": ["TEST: Then the job is finished. Thank you."], "end": true },
  },
}
